# Public URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://grtendaggiconcept.it

# Contact form delivery (Resend, https://resend.com). Without these the form
# answers "not configured" and offers email/phone instead — nothing is faked.
RESEND_API_KEY=
CONTACT_TO_EMAIL=grtendaggiconcept@gmail.com
# Must be an address on a domain verified in Resend, e.g. "Sito GR Tendaggi <sito@grtendaggiconcept.it>"
CONTACT_FROM_EMAIL=

# Optional company details shown only when provided
NEXT_PUBLIC_COMPANY_VAT=
# Business WhatsApp number in international format, e.g. 393791944480 (only if verified)
NEXT_PUBLIC_WHATSAPP_NUMBER=
